{
  "expo": {
    "name": "NePerdas",
    "slug": "neperdas",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neperdas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neperdas.app",
      "infoPlist": {
        "CFBundleDisplayName": "NePerdas",
        "NSCameraUsageDescription": "NePerdas uses the camera to scan food package labels and expiry dates.",
        "NSPhotoLibraryUsageDescription": "NePerdas needs photo library access to scan food package photos.",
        "NSCalendarsUsageDescription": "NePerdas can add expiry reminders to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "NePerdas can add expiry reminders to your calendar.",
        "NSRemindersUsageDescription": "NePerdas can create reminders for food expiry dates.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.neperdas.app",
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200,
          "ios": {
            "imageWidth": 300
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NePerdas uses the camera to scan food package labels and expiry dates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NePerdas needs photo library access to scan food package photos."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "NePerdas can add expiry reminders to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2E7D32"
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35f21816-2900-489c-bf45-c4d8bff03084"
      }
    },
    "owner": "sa25.devs"
  }
}
